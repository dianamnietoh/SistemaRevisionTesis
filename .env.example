# ===== Base de datos (Supabase) =====
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ===== Servidor =====
PORT=4000
NODE_ENV=development
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:5173

# ===== Seguridad =====
# Secreto para firmar los JWT. Genera uno largo y aleatorio.
JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-larga

# ===== Revisión con IA =====
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=tu-api-key
AI_MODEL=gpt-4o-mini
AI_RESPONSE_DAYS=5

# ===== Balanceador de cargas (solo en servidor Node local, no en Vercel) =====
# Número de workers del proceso. Vacío = min(cpus, 4). Usa 1 para desactivar.
# CLUSTER_WORKERS=4
